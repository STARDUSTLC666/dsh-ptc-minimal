{
  "name": "dsh-ptc-minimal",
  "version": "0.1.0",
  "description": "DSH 插件：极简 PTC 模式 —— 对齐 RL 训练的一句话提示词，继承 PTC 全量工具，Code Mode SDK 内置灰测级思维链",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-preset",
    "code-mode"
  ],
  "license": "MIT",
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-ptc-minimal.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-ptc-minimal/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-ptc-minimal#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "packageManager": "pnpm@11.7.0"
}
